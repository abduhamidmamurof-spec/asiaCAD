(vl-load-com)
(defun c:KVADRAT (/ p s)
  (setq p (getpoint "\nNuqta: "))
  (setq s (getdist "\nTomon: "))
  (command "_.PLINE" p (polar p 0 s) (polar p (/ pi 2) s) "_C")
  (command "_.TEXT" p 2.5 0 (strcat "S=" (rtos (* s s) 2 2)))
  (princ))
(defun c:JAMIUZUN (/ ss i e sum)
  (setq ss (ssget "X" '((0 . "LINE,LWPOLYLINE,CIRCLE,ARC"))) sum 0.0 i 0)
  (repeat (sslength ss)
    (setq e (ssname ss i) i (1+ i)
          sum (+ sum (vlax-curve-getDistAtParam e (vlax-curve-getEndParam e)))))
  (princ (strcat "\nJami uzunlik: " (rtos sum 2 3)))
  (princ))
(defun c:VLASINOV (/ ms o)
  (setq ms (vla-get-modelspace (vla-get-activedocument (vlax-get-acad-object))))
  (setq o (vla-addline ms (vlax-3d-point 0 0 0) (vlax-3d-point 3 4 0)))
  (vla-put-layer o "VLA")
  (princ (strcat "\nL=" (rtos (vla-get-length o) 2 2) " " (vla-get-layer o)))
  (princ))
(princ)
