(defun c:DCLAYLANA (/ id r q st)
  (setq id (load_dialog "sinov.dcl"))
  (if (not (new_dialog "sinov" id)) (exit))
  (start_list "qat") (mapcar 'add_list '("0" "A" "B")) (end_list)
  (set_tile "qat" "1")
  (action_tile "accept" "(setq r (atof (get_tile \"r\")) q (get_tile \"qat\")) (done_dialog 1)")
  (action_tile "cancel" "(done_dialog 0)")
  (setq st (start_dialog))
  (unload_dialog id)
  (if (= st 1) (command "CIRCLE" "0,0" r))
  (princ (strcat "\nHolat " (itoa st)))
  (princ))
